#include <iostream>
using namespace std;
int main() {
    int filas;

    cout << "Ingresa el numero de filas para el triangulo: ";
    cin >> filas;

    for (int i = 1; i <= filas; i++) {
      
        for (int j = 1; j <= i; j++) {
            cout << "* ";
        }
        cout << endl; // Salto de línea al terminar cada fila
    }

    return 0;
}
