#include <iostream>
using namespace std;
int main() {
    int n;
    int divisores = 0;

    cout << "Ingresa un numero para verificar si es primo: ";
    cin >> n;

    if (n <= 1) {
        cout << n << " no es un numero primo." << endl;
        return 0;
    }

    for (int i = 2; i < n; i++) {
        if (n % i == 0) {
            divisores++;
            break; 
        }
    }

    if (divisores == 0) {
        cout << n << " ES un numero primo." << endl;
    } else {
        cout << n << " NO es un numero primo." << endl;
    }

    return 0;
}
