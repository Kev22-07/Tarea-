#include <iostream>
using namespace std;
int main() {
    int n;
    cout << "Ingresa un numero para ver su tabla de multiplicar: ";
    cin >> n;

    cout << "\n--- Tabla del " << n << " ---\n";
    for (int i = 1; i <= 10; i++) {
        cout << n << " x " << i << " = " << n * i << endl;
    }

    return 0;
}
