#include <iostream>

using namespace std;

int main() {
    for (int i = 0; i < 7; i++) {
        
        for (int j = 0; j < 5; j++) {
            if (j == 0 || i == 0 || i == 3 || i == 6) cout << "*";
            else cout << " ";
        }
        cout << "   "; // Espacio entre letras

        for (int j = 0; j < 5; j++) {
            if (j == 0 || (i + j == 4 && i <= 3) || (i - j == 2 && i > 3)) cout << "*";
            else cout << " ";
        }
        cout << "   ";

        for (int j = 0; j < 5; j++) {
            if (j == 0 || j == 4 || (i == j && i <= 2) || (i + j == 4 && i <= 2)) cout << "*";
            else cout << " ";
        }
        cout << "   ";

        for (int j = 0; j < 5; j++) {
            if ((i == 0 || i == 4) && (j > 0 && j < 4)) cout << "*";
            else if ((j == 0 || j == 4) && (i > 0 && i < 4)) cout << "*";
            else if (i == j && i >= 3) cout << "*";
            else cout << " ";
        }

        cout << "\n"; 
    }

    return 0;
}
