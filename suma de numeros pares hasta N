#include <iostream>
using namespace std;
int main() {
    int n;
    int suma = 0;

    cout << "Ingresa un limite superior (N): ";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        if (i % 2 == 0) { // Verifica si el número es par
            suma += i;    // Acumula la suma
        }
    }

    cout << "La suma de todos los numeros pares desde 1 hasta " << n << " es: " << suma << endl;

    return 0;
}
