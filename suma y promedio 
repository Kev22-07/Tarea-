#include <iostream>
using namespace std;
int main() {
    int n;
    double suma = 0.0, valor;

    cout << "Ingrese la cantidad de elementos: ";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        cout << "Ingrese el valor " << i << ": ";
        cin >> valor;
        suma += valor; // Acumulamos el valor leido
    }

    double promedio = suma / n;
    cout << "\nSuma total: " << suma << endl;
    cout << "Promedio: " << promedio << endl;

    return 0;
}
